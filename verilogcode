// 3 - 8 decoder in behaviroul level module
module decoder3to8(d,e,y);
  input [2:0] d;
  input e;
  output [7:0]y;
  reg[7:0]y;
  always@(d,e)
    begin
      if (e == 1)
      case(d)
        3'b000:y=8'b10000000;
        3'b001:y=8'b01000000;
        3'b010:y=8'b00100000;
        3'b011:y=8'b00010000;
        3'b100:y=8'b00001000;
        3'b101:y=8'b00000100;
        3'b110:y=8'b00000010;
        3'b111:y=8'b00000001;
      endcase
        else 
          y=8'b00000000;
    end
endmodule 
